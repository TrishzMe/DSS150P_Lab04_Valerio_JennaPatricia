# Copy this file to .env and fill in environment-specific values.
# .env is git-ignored; never commit real credentials.

# --- PostgreSQL credentials (used by docker-compose and by the pipeline) ---
POSTGRES_USER=repro
POSTGRES_PASSWORD=change_me
POSTGRES_DB=air_quality

# Port published on your machine. 5434 avoids clashing with a local PostgreSQL (5432)
# and with other course projects that publish 5433.
POSTGRES_HOST_PORT=5434

# Where the pipeline finds PostgreSQL when it runs from a LOCAL virtual environment.
# (Inside docker-compose the containers always use host "postgres", port 5432; compose sets that.)
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 first and each connection
# waits ~10 s before falling back, because the container port is published on IPv4 only.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434

# --- Airflow ---
# Port for the Airflow web UI on your machine (http://localhost:8081; 8080 is often taken).
AIRFLOW_HOST_PORT=8081
# Password for the Airflow "admin" user.
AIRFLOW_ADMIN_PASSWORD=change_me_too

# --- Optional pipeline overrides (leave blank to use config/settings.yml) ---
# PIPELINE_RUN_ID=
